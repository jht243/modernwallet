---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { EDITORIAL_REVIEWER, OPERATOR, SITE } from "../../data/site";
import { profilePageSchema } from "../../lib/jsonld";

const canonicalUrl = new URL(EDITORIAL_REVIEWER.path, Astro.site).toString();
const jsonLdProfile = profilePageSchema(canonicalUrl);
const jsonLdBreadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: SITE.name, item: new URL("/", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name: "About", item: new URL("/about/", Astro.site).toString() },
    { "@type": "ListItem", position: 3, name: EDITORIAL_REVIEWER.displayName, item: canonicalUrl },
  ],
};
---
<BaseLayout
  title={`${EDITORIAL_REVIEWER.displayName} — ${EDITORIAL_REVIEWER.role} | ${SITE.name}`}
  description={`Verified profile for ${EDITORIAL_REVIEWER.displayName}, ${EDITORIAL_REVIEWER.role} of ${SITE.name}. Harvard Business School MBA and Founder & CEO of ${OPERATOR.name}.`}
  canonical={canonicalUrl}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdProfile)} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdBreadcrumb)} />

  <main class="page">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">{SITE.name}</a> <span>/</span>
      <a href="/about/">About</a> <span>/</span>
      <span class="crumb-current">{EDITORIAL_REVIEWER.displayName}</span>
    </nav>

    <header class="profile-hero">
      <img
        src={EDITORIAL_REVIEWER.imagePath}
        alt={EDITORIAL_REVIEWER.displayName}
        width="104"
        height="104"
        class="portrait"
      />
      <div>
        <p class="eyebrow">{EDITORIAL_REVIEWER.role}</p>
        <h1>{EDITORIAL_REVIEWER.displayName}</h1>
        <p class="creds">{EDITORIAL_REVIEWER.credentialSummary}</p>
        <div class="verify-links">
          <a href="https://www.jonathanteplitsky.com/" target="_blank" rel="noopener">Official Website &nearr;</a>
          <a href="https://www.linkedin.com/in/jonathanteplitsky/" target="_blank" rel="noopener">LinkedIn Profile &nearr;</a>
          <a href={OPERATOR.url} target="_blank" rel="noopener">{OPERATOR.name} &nearr;</a>
        </div>
      </div>
    </header>

    <section class="section">
      <h2>Background &amp; Credentials</h2>
      <p>{EDITORIAL_REVIEWER.bio}</p>
      <ul class="facts">
        <li><strong>Education:</strong> Master of Business Administration (MBA), Harvard Business School (2014–2016); B.A., Defense Language Institute Foreign Language Center.</li>
        <li><strong>Operating Experience:</strong> Founder &amp; CEO of Layer3Labs; former Senior Marketing Manager at Amazon (grew a $200M+ consumer business); former Product Manager at Uber.</li>
        <li><strong>Military Service:</strong> Former U.S. Army Captain (Military Intelligence, 2009–2020).</li>
      </ul>
    </section>

    <section class="section">
      <h2>Role at {SITE.name}</h2>
      <p>
        {SITE.name} separates content production from editorial oversight. Our{" "}
        <a href="/editorial-policy/">Research Desk</a> builds standard financial calculators and drafts
        educational guides using primary government and regulatory sources (CFPB, IRS, Federal Reserve,
        and FDIC). Jonathan Teplitsky oversees editorial standards, reviews calculator methodology and
        editorial disclosures, and sets update rules when rates, tax thresholds, or formulas change.
      </p>
      <p>
        <strong>Focus areas:</strong> {EDITORIAL_REVIEWER.knowsAbout.join(", ")}.
      </p>
      <p class="scope-note">
        Editorial review checks clarity, source quality, and mathematical framing for general education.
        {SITE.name} does not provide individualized financial, tax, or legal advice.
      </p>
    </section>
  </main>

  <style>
    .page { max-width: 820px; margin: 0 auto; padding: 16px 20px 56px; }
    .crumb { font-size: 0.875rem; color: #666; padding: 8px 0 16px; }
    .crumb a { color: var(--primary-dark); text-decoration: none; }
    .crumb-current { color: #999; }
    .profile-hero { display: flex; gap: 22px; align-items: center; padding: 8px 0 22px; }
    .portrait { width: 104px; height: 104px; border-radius: 50%; object-fit: cover; flex-shrink: 0; border: 2px solid #d9e6e0; }
    .eyebrow { margin: 0 0 4px; font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--primary-dark); }
    .profile-hero h1 { font-size: 2.1rem; margin: 0 0 6px; }
    .creds { margin: 0 0 12px; color: #4a5a54; font-weight: 500; }
    .verify-links { display: flex; flex-wrap: wrap; gap: 10px 16px; font-size: 0.88rem; }
    .verify-links a { color: var(--primary-dark); font-weight: 600; text-decoration: none; }
    .verify-links a:hover { text-decoration: underline; }
    .section { padding: 18px 0 12px; border-top: 1px solid #EEF2F0; }
    .section h2 { font-size: 1.4rem; margin: 0 0 12px; }
    .section p, .facts li { color: #333; line-height: 1.7; max-width: 720px; }
    .facts { padding-left: 20px; margin: 12px 0 0; }
    .facts li { margin-bottom: 8px; }
    .scope-note { background: #f5f9f7; border-left: 3px solid var(--primary-dark); padding: 10px 14px; border-radius: 6px; font-size: 0.92rem; }
    @media (max-width: 600px) {
      .profile-hero { flex-direction: column; align-items: flex-start; }
      .profile-hero h1 { font-size: 1.75rem; }
    }
  </style>
</BaseLayout>
