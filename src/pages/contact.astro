---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../data/site";

const canonicalUrl = new URL("/contact/", Astro.site).toString();
const jsonLdBreadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: SITE.name, item: new URL("/", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name: "Contact", item: canonicalUrl },
  ],
};
---
<BaseLayout
  title={`Contact ${SITE.name}`}
  description={`Contact ${SITE.name} with a question, a correction, or a suggestion for a calculator or guide.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdBreadcrumb)} />

  <main class="page">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">{SITE.name}</a> <span>/</span>
      <span class="crumb-current">Contact</span>
    </nav>

    <header class="hero">
      <h1>Contact {SITE.name}</h1>
      <p class="lede">Have a question, spotted an error, or want a calculator or guide we don't have yet? Send us a note.</p>
    </header>

    <section class="section">
      <form id="contact-form" class="contact-form" novalidate>
        <div class="field">
          <label for="cf-name">Name</label>
          <input id="cf-name" name="name" type="text" required autocomplete="name" />
        </div>
        <div class="field">
          <label for="cf-email">Email</label>
          <input id="cf-email" name="email" type="email" required autocomplete="email" />
        </div>
        <div class="field">
          <label for="cf-message">Message</label>
          <textarea id="cf-message" name="message" rows="6" required></textarea>
        </div>
        <div class="hp" aria-hidden="true">
          <label for="cf-company-url">Company URL</label>
          <input id="cf-company-url" name="company_url" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <button id="cf-submit" class="submit-btn" type="submit">Send message</button>
        <p id="cf-status" class="cf-status" role="status" aria-live="polite" hidden></p>
      </form>
    </section>
  </main>

  <script is:inline>
    (function () {
      var form = document.getElementById('contact-form');
      if (!form) return;
      var btn = document.getElementById('cf-submit');
      var status = document.getElementById('cf-status');
      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        if (form.company_url && form.company_url.value.trim() !== '') {
          form.reset();
          status.hidden = false;
          status.className = 'cf-status ok';
          status.textContent = 'Thanks — your message has been sent.';
          return;
        }
        btn.disabled = true;
        status.hidden = true;
        try {
          var res = await fetch('https://layer3labs-web.onrender.com/api/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              name: form.name.value.trim(),
              email: form.email.value.trim(),
              message: form.message.value.trim(),
              site: 'ModernWallet',
              sourceUrl: window.location.href,
              accent: '#0E7C66',
              company_url: ''
            })
          });
          status.hidden = false;
          if (res.ok) {
            form.reset();
            status.className = 'cf-status ok';
            status.textContent = 'Thanks — your message has been sent.';
          } else {
            status.className = 'cf-status err';
            status.textContent = 'Something went wrong — please try again.';
          }
        } catch (err) {
          status.hidden = false;
          status.className = 'cf-status err';
          status.textContent = 'Something went wrong — please try again.';
        } finally {
          btn.disabled = false;
        }
      });
    })();
  </script>

  <style>
    .page { max-width: 820px; margin: 0 auto; padding: 16px 20px 56px; }
    .crumb { font-size: 0.875rem; color: #666; padding: 8px 0 12px; }
    .crumb a { color: var(--primary-dark); text-decoration: none; }
    .crumb-current { color: #999; }
    .hero { padding: 8px 0 16px; }
    .hero h1 { font-size: 2.3rem; margin: 0 0 12px; }
    .lede { font-size: 1.12rem; color: #444; line-height: 1.6; margin: 0; }
    .section { padding: 24px 0; border-top: 1px solid #EEF2F0; }
    .contact-form { max-width: 560px; }
    .field { margin-bottom: 18px; display: flex; flex-direction: column; gap: 6px; }
    .field label { font-weight: 700; font-size: 0.9rem; color: #333; }
    .contact-form input, .contact-form textarea {
      font: inherit; font-size: 16px; padding: 11px 13px;
      border: 1px solid #D6DEDA; border-radius: 8px; background: #fff; color: #1a1a1a; width: 100%;
    }
    .contact-form input:focus, .contact-form textarea:focus { outline: none; border-color: var(--primary); }
    .contact-form textarea { resize: vertical; }
    .submit-btn {
      display: inline-flex; align-items: center; justify-content: center;
      background: var(--primary); color: #fff; border: 1px solid var(--primary);
      font-weight: 700; font-size: 1rem; padding: 11px 22px; border-radius: 8px; cursor: pointer;
    }
    .submit-btn:hover { background: var(--primary-dark); border-color: var(--primary-dark); }
    .submit-btn[disabled] { opacity: .6; cursor: not-allowed; }
    .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
    .cf-status { margin-top: 14px; font-size: 0.95rem; }
    .cf-status.ok { color: var(--primary-dark); font-weight: 600; }
    .cf-status.err { color: #b3261e; font-weight: 600; }
    @media (max-width: 600px) { .hero h1 { font-size: 1.85rem; } }
  </style>
</BaseLayout>
