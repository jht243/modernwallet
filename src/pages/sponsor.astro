---
// "Advertise With Us" form. Posts to the SHARED fleet vendor intake on
// Layer3Labs (/api/listing-update, intent=sponsor), which sends the
// ModernWallet-branded auto-reply, the 48h follow-up and the team email.
// The site is identified server-side from this page's Origin.
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../data/site";
---
<BaseLayout
  title={`Advertise With Us | ${SITE.name}`}
  description={`Put your financial product or service in front of ${SITE.name} readers. Tell us about it and we'll send our advertising options.`}
  robots="noindex, follow"
>
  <main class="page">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">{SITE.name}</a> <span>/</span>
      <span class="crumb-current">Advertise With Us</span>
    </nav>

    <header class="hero">
      <h1>Advertise With Us</h1>
      <p class="lede" id="sponsor-intro">Want your financial product or service in front of our readers? Tell us a bit about it and we'll email you our advertising options.</p>
    </header>

    <section class="section">
      <div id="sponsor-success" class="sp-success" role="status" hidden>
        <p class="sp-success-title">Got it, thanks for reaching out</p>
        <p class="sp-success-text">We've emailed you our advertising options. We'll be in touch soon.</p>
      </div>

      <form id="sponsor-form" class="sp-form">
        <div class="sp-grid">
          <div class="field">
            <label for="sp-name">Name <span class="req">*</span></label>
            <input id="sp-name" name="name" type="text" required autocomplete="name" placeholder="Your name" />
          </div>
          <div class="field">
            <label for="sp-email">Email <span class="req">*</span></label>
            <input id="sp-email" name="email" type="email" required autocomplete="email" placeholder="you@company.com" />
          </div>
          <div class="field">
            <label for="sp-company">Company <span class="req">*</span></label>
            <input id="sp-company" name="companyName" type="text" required autocomplete="organization" placeholder="Acme Bank" />
          </div>
          <div class="field">
            <label for="sp-url">Website <span class="opt">(optional)</span></label>
            <input id="sp-url" name="companyUrl" type="text" placeholder="acmebank.com" />
          </div>
        </div>
        <div class="field">
          <label for="sp-message">Tell us about your company <span class="req">*</span></label>
          <textarea id="sp-message" name="change" rows="5" required placeholder="Your product or service and who it's for"></textarea>
        </div>

        <!-- Honeypot: real visitors never see or fill this -->
        <div class="hp" aria-hidden="true">
          <label for="sp-company_url">Company URL</label>
          <input id="sp-company_url" name="company_url" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <button id="sponsor-submit" class="submit-btn" type="submit">Get advertising options</button>
        <p id="sponsor-error" class="sp-error" role="alert" hidden></p>
      </form>
    </section>
  </main>

  <script is:inline>
    (function () {
      var form = document.getElementById('sponsor-form');
      var success = document.getElementById('sponsor-success');
      var intro = document.getElementById('sponsor-intro');
      var errorMsg = document.getElementById('sponsor-error');
      if (!form) return;
      var renderedAt = Date.now();
      var btn = document.getElementById('sponsor-submit');

      // The page the vendor clicked from (?from=/compare/...), else this page. Same-site paths only.
      function sourcePage() {
        var from = new URLSearchParams(window.location.search).get('from') || '';
        return /^\/[a-z0-9\/-]*$/i.test(from) ? window.location.origin + from : window.location.href;
      }
      function val(name) { return ((form.querySelector('[name="' + name + '"]') || {}).value || '').trim(); }

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        btn.disabled = true;
        btn.textContent = 'Sending…';
        errorMsg.hidden = true;

        fetch('https://layer3labs-web.onrender.com/api/listing-update', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: val('name'),
            email: val('email'),
            companyName: val('companyName'),
            companyUrl: val('companyUrl'),
            change: val('change'),
            intent: 'sponsor',
            sourceUrl: sourcePage(),
            company_url: val('company_url'),
            formRenderedAt: renderedAt
          })
        })
          .then(function (res) {
            if (res.ok) {
              form.hidden = true;
              if (intro) intro.hidden = true;
              success.hidden = false;
              return;
            }
            return res.json().catch(function () { return {}; }).then(function (data) {
              throw new Error(data.error || 'Something went wrong — please try again.');
            });
          })
          .catch(function (err) {
            errorMsg.textContent = (err && err.message && err.message !== 'Failed to fetch') ? err.message : 'Network error — please try again.';
            errorMsg.hidden = false;
            btn.disabled = false;
            btn.textContent = 'Get advertising options';
          });
      });
    })();
  </script>

  <style>
    .page { max-width: 820px; margin: 0 auto; padding: 16px 20px 56px; }
    .crumb { font-size: 0.875rem; color: #666; padding: 8px 0 12px; }
    .crumb a { color: var(--primary-dark); text-decoration: none; }
    .crumb-current { color: #999; }
    .hero { padding: 8px 0 16px; }
    .hero h1 { font-size: 2.3rem; margin: 0 0 12px; }
    .lede { font-size: 1.12rem; color: #444; line-height: 1.6; margin: 0; }
    .lede[hidden], .sp-form[hidden], .sp-success[hidden], .sp-error[hidden] { display: none; }
    .section { padding: 24px 0; border-top: 1px solid #EEF2F0; }
    .sp-form { max-width: 640px; }
    .sp-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 16px; }
    .field { margin-bottom: 18px; display: flex; flex-direction: column; gap: 6px; }
    .field label { font-weight: 700; font-size: 0.9rem; color: #333; }
    .req { color: #b3261e; }
    .opt { font-weight: 400; color: var(--muted); }
    .sp-form input, .sp-form textarea {
      font: inherit; font-size: 16px; padding: 11px 13px;
      border: 1px solid #D6DEDA; border-radius: 8px; background: #fff; color: #1a1a1a; width: 100%;
    }
    .sp-form input:focus, .sp-form textarea:focus { outline: none; border-color: var(--primary); }
    .sp-form textarea { resize: vertical; }
    .submit-btn {
      display: inline-flex; align-items: center; justify-content: center;
      background: var(--primary); color: #fff; border: 1px solid var(--primary);
      font-weight: 700; font-size: 1rem; padding: 11px 22px; border-radius: 8px; cursor: pointer;
    }
    .submit-btn:hover { background: var(--primary-dark); border-color: var(--primary-dark); }
    .submit-btn[disabled] { opacity: .6; cursor: progress; }
    .hp { position: absolute; left: -9999px; top: -9999px; width: 1px; height: 1px; overflow: hidden; }
    .sp-error {
      margin: 14px 0 0; padding: 10px 14px; border: 1px solid #f3c2bf; border-radius: 8px;
      background: #fdecea; color: #7f1d1d; font-weight: 600; font-size: 0.95rem;
    }
    .sp-success {
      max-width: 640px; padding: 28px 24px; text-align: center;
      background: #F4FAF8; border: 1px solid #D8EEE6; border-radius: 14px;
    }
    .sp-success-title { margin: 0; font-size: 1.35rem; font-weight: 800; color: #1a3a30; }
    .sp-success-text { margin: 8px 0 0; color: var(--muted); }
    @media (max-width: 600px) { .hero h1 { font-size: 1.85rem; } .sp-grid { grid-template-columns: 1fr; } }
  </style>
</BaseLayout>
