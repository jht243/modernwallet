---
import BaseLayout from "../layouts/BaseLayout.astro";
import { OPERATOR, SITE } from "../data/site";

const canonicalUrl = new URL("/privacy-policy/", Astro.site).toString();
const updated = "October 4, 2026";
const jsonLdBreadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: SITE.name, item: new URL("/", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name: "Privacy Policy", item: canonicalUrl },
  ],
};
---
<BaseLayout
  title={`Privacy Policy — ${SITE.name}`}
  description={`How ${SITE.name} collects, uses, and protects information when you use our free financial calculators and guides.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdBreadcrumb)} />

  <main class="page">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">{SITE.name}</a> <span>/</span>
      <span class="crumb-current">Privacy Policy</span>
    </nav>

    <header class="hero">
      <h1>Privacy Policy</h1>
      <p class="lede">Last updated: {updated}</p>
    </header>

    <section class="section">
      <h2>Who we are</h2>
      <p>
        {SITE.name} ({SITE.url.replace("https://", "")}) is operated by
        <a href={OPERATOR.url} target="_blank" rel="noopener">{OPERATOR.name}</a>. This policy explains what
        information we collect when you visit the site, how we use it, and the choices you have.
      </p>
    </section>

    <section class="section">
      <h2>Information we collect</h2>
      <p><strong>Calculator inputs.</strong> Our calculators run in your browser. The numbers you type into them are not sent to us or stored on our servers.</p>
      <p><strong>Information you send us.</strong> If you use our <a href="/contact/">contact form</a>, we receive your name, email address, and message. We use them only to reply to you.</p>
      <p><strong>Site search.</strong> When you use the search box, we log the search term and the number of results. We use this to find topics readers want that we haven't covered yet. Search logs are not tied to your name or email.</p>
      <p><strong>Usage data.</strong> Like most websites, we automatically collect standard technical information such as your IP address, browser type, device type, referring page, pages viewed, and time spent on the site.</p>
    </section>

    <section class="section">
      <h2>Cookies and similar technologies</h2>
      <p>We and our partners use cookies, pixels, and similar technologies to run the site, measure traffic, and serve advertising. You can block or delete cookies in your browser settings. Some features may not work as intended if you do.</p>
    </section>

    <section class="section">
      <h2>Analytics</h2>
      <p>
        We use Google Analytics to understand how visitors use the site. Google Analytics uses cookies to collect
        usage data, which Google processes under its own
        <a href="https://policies.google.com/privacy" target="_blank" rel="noopener">privacy policy</a>.
        You can opt out with the
        <a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noopener">Google Analytics opt-out browser add-on</a>.
      </p>
    </section>

    <section class="section">
      <h2>Advertising</h2>
      <p>
        This website uses Mediavine to manage third-party interest-based advertising. Mediavine serves content and
        advertisements when you visit the website, which may use first- and third-party cookies. A cookie is a small
        text file sent to your device by the web server so that a website can remember information about your
        browsing activity.
      </p>
      <p>
        First-party cookies are created by the site you are visiting. Third-party cookies are frequently used in
        behavioral advertising and analytics and are created by a domain other than the website you are visiting.
        Third-party cookies, tags, pixels, beacons, and other similar technologies may be placed on the website to
        monitor interaction with advertising content and to target and optimize advertising. Each internet browser
        has functionality so that you can block both first- and third-party cookies and clear your browser's cache.
      </p>
      <p>
        For more information about Mediavine's data collection practices, see the
        <a href="https://www.mediavine.com/ad-partners/" target="_blank" rel="noopener">Mediavine Partner Privacy Policy</a>.
        You can also visit
        <a href="https://optout.aboutads.info/" target="_blank" rel="noopener">optout.aboutads.info</a> and
        <a href="https://optout.networkadvertising.org/" target="_blank" rel="noopener">optout.networkadvertising.org</a>
        to learn more about interest-based advertising and how to opt out of it.
      </p>
    </section>

    <section class="section">
      <h2>Affiliate and referral links</h2>
      <p>Some links on {SITE.name} are affiliate or referral links. If you click one and sign up or buy, the partner may use cookies to credit us with the referral. We may earn a commission at no cost to you. Partners handle any information you give them under their own privacy policies.</p>
    </section>

    <section class="section">
      <h2>How we use information</h2>
      <ul>
        <li>To operate, maintain, and improve the site and its calculators</li>
        <li>To understand which content is useful and what to build next</li>
        <li>To respond to messages you send us</li>
        <li>To serve and measure advertising</li>
        <li>To detect and prevent spam, abuse, and security issues</li>
      </ul>
      <p>We do not sell your name, email address, or the contents of your messages.</p>
    </section>

    <section class="section">
      <h2>Your privacy rights</h2>
      <p>
        Depending on where you live, including California, other U.S. states with privacy laws, the European
        Economic Area, and the United Kingdom, you may have the right to access, correct, or delete your personal
        information, to object to or restrict certain processing, and to opt out of the sale or sharing of personal
        information for targeted advertising. To make a request, use our <a href="/contact/">contact form</a>.
        We will not discriminate against you for using these rights.
      </p>
      <p>Where required by law, a consent or opt-out notice will appear when you visit the site, and you can change your choices at any time.</p>
    </section>

    <section class="section">
      <h2>Children's privacy</h2>
      <p>{SITE.name} is not directed to children under 13, and we do not knowingly collect personal information from them. If you believe a child has given us personal information, contact us and we will delete it.</p>
    </section>

    <section class="section">
      <h2>Data retention and security</h2>
      <p>We keep information only as long as we need it for the purposes above or as required by law. We use reasonable safeguards to protect it, but no method of transmission or storage is completely secure.</p>
    </section>

    <section class="section">
      <h2>Changes to this policy</h2>
      <p>We may update this policy from time to time. When we do, we will change the "Last updated" date at the top of this page.</p>
    </section>

    <section class="section">
      <h2>Contact us</h2>
      <p>Questions about this policy? Reach us through our <a href="/contact/">contact page</a>.</p>
    </section>
  </main>

  <style>
    .page { max-width: 820px; margin: 0 auto; padding: 16px 20px 56px; }
    .crumb { font-size: 0.875rem; color: #666; padding: 8px 0 12px; }
    .crumb a { color: var(--primary-dark); text-decoration: none; }
    .crumb-current { color: #999; }
    .hero { padding: 8px 0 16px; }
    .hero h1 { font-size: 2.3rem; margin: 0 0 12px; }
    .lede { font-size: 1rem; color: #666; margin: 0; }
    .section { padding: 20px 0; border-top: 1px solid #EEF2F0; }
    .section h2 { font-size: 1.3rem; margin: 0 0 10px; }
    .section p, .section li { line-height: 1.65; color: #333; }
    .section ul { padding-left: 20px; }
    .section a { color: var(--primary-dark); }
    @media (max-width: 600px) { .hero h1 { font-size: 1.85rem; } }
  </style>
</BaseLayout>
