---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE } from "../../data/site";
import { COMPARISONS } from "../../data/comparisons";

const canonicalUrl = new URL("/compare/", Astro.site).toString();
const entries = COMPARISONS.filter((c) => !c.draft).sort((a, b) => a.title.localeCompare(b.title));

const jsonLdBreadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: SITE.name, item: new URL("/", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name: "Compare", item: canonicalUrl },
  ],
};
---
<BaseLayout
  title={`Money Comparisons — ${SITE.name}`}
  description="Side-by-side comparisons of the money decisions people actually face — accounts, loans, and financial products compared head-to-head."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdBreadcrumb)} />

  <main class="page">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">{SITE.name}</a> <span>/</span>
      <span class="crumb-current">Compare</span>
    </nav>

    <header class="hero">
      <h1>Money comparisons</h1>
      <p class="lede">Side-by-side breakdowns of the money decisions people actually face — which account, loan, or product wins for your situation.</p>
    </header>

    <div class="grid">
      {entries.map((c) => (
        <a class="ccard" href={`/compare/${c.slug}/`}>
          <span class="ccard-vs">{c.optionA} vs {c.optionB}</span>
          <span class="ccard-title">{c.title}</span>
        </a>
      ))}
    </div>
  </main>

  <style>
    .page { max-width: 1000px; margin: 0 auto; padding: 16px 20px 56px; }
    .crumb { font-size: 0.875rem; color: #666; padding: 8px 0 12px; }
    .crumb a { color: var(--primary-dark); text-decoration: none; }
    .crumb-current { color: #999; }
    .hero { padding: 8px 0 18px; border-bottom: 1px solid #eee; margin-bottom: 20px; }
    .hero h1 { font-size: 2.4rem; margin: 0 0 12px; }
    .lede { font-size: 1.15rem; color: #444; max-width: 720px; line-height: 1.6; margin: 0; }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); gap: 16px; }
    .ccard { display: flex; flex-direction: column; gap: 8px; padding: 20px; border: 1px solid #E0EFE9; border-radius: 14px; background: #fff; text-decoration: none; color: var(--text); transition: border-color 120ms ease, transform 120ms ease, box-shadow 120ms ease; }
    .ccard:hover { border-color: var(--primary); transform: translateY(-1px); box-shadow: 0 8px 20px -12px rgba(0,0,0,0.12); }
    .ccard-vs { font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--primary-dark, #0a5c4a); }
    .ccard-title { font-weight: 600; font-size: 1.02rem; line-height: 1.4; }
    @media (max-width: 600px) { .hero h1 { font-size: 1.9rem; } }
  </style>
</BaseLayout>
