---
// Compliance Alert spoke page: one page per new law/rule that imposes an obligation on businesses.
// Structure mirrors [category]/[slug].astro — obligation summary box above the fold, plain-English
// sections, FAQs, YMYL legal treatment (attorney byline + disclaimer), then the lead form.
// No-orphan rule: breadcrumb links up to /compliance/ and relatedSlugs render sibling links.
import BaseLayout from "../../layouts/BaseLayout.astro";
import LinkCard from "../../components/LinkCard.astro";
import Byline from "../../components/Byline.astro";
import Sources from "../../components/Sources.astro";
import LegalDisclaimer from "../../components/LegalDisclaimer.astro";
import ComplianceLeadForm from "../../components/ComplianceLeadForm.astro";
import CrossLinks from "../../components/CrossLinks.astro";
import { SITE, LAST_UPDATED, REVIEWER } from "../../data/site";
import { liveAlerts, relatedAlerts } from "../../data/compliance-alerts";
import { linkify, plain, paragraphs } from "../../lib/richtext";
import { personSchema, articleSchema, reviewerPersonSchema } from "../../lib/jsonld";

export function getStaticPaths() {
  return liveAlerts().map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const related = relatedAlerts(entry, 3);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const reviewer = entry.reviewer ?? REVIEWER;

const URGENCY_LABEL = { high: "Act now", medium: "Deadline this year", low: "On the horizon" } as const;

/** "2026-12-31" → "December 31, 2026"; anything non-ISO passes through unchanged. */
function fmtDate(value?: string): string | undefined {
  if (!value) return undefined;
  if (!/^\d{4}-\d{2}-\d{2}$/.test(value)) return value;
  return new Date(value + "T00:00:00Z").toLocaleDateString("en-US", {
    year: "numeric", month: "long", day: "numeric", timeZone: "UTC",
  });
}
const effective = fmtDate(entry.effectiveDate);
const deadline = fmtDate(entry.deadline);

// ---- JSON-LD ----
const jsonLdFaq = entry.faqs.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: entry.faqs.map((f) => ({
        "@type": "Question",
        name: f.question,
        acceptedAnswer: { "@type": "Answer", text: plain(f.answer) },
      })),
    }
  : null;

const jsonLdBreadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: SITE.name, item: new URL("/", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name: "Compliance Alerts", item: new URL("/compliance/", Astro.site).toString() },
    { "@type": "ListItem", position: 3, name: entry.targetKeyword, item: canonicalUrl },
  ],
};

// The law/rule itself as a schema.org Legislation entity — the semantically-correct node for a
// "new law explained" page (vs. WebApplication on calculator pages).
const jsonLdLegislation = {
  "@context": "https://schema.org",
  "@type": "Legislation",
  name: entry.citation,
  url: entry.citationUrl,
  legislationJurisdiction: entry.jurisdiction,
  ...(entry.effectiveDate && /^\d{4}-\d{2}-\d{2}$/.test(entry.effectiveDate)
    ? { legislationDate: entry.effectiveDate }
    : {}),
};

const jsonLdPerson = personSchema();
const jsonLdReviewerPerson = reviewerPersonSchema(reviewer);
const jsonLdArticle = articleSchema({
  headline: entry.h1,
  description: entry.metaDescription,
  url: canonicalUrl,
  datePublished: LAST_UPDATED,
  sources: entry.sources,
  reviewedBy: reviewer,
});
---
<BaseLayout title={entry.title} description={entry.metaDescription}>
  {jsonLdFaq && <script type="application/ld+json" set:html={JSON.stringify(jsonLdFaq)} />}
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdBreadcrumb)} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdLegislation)} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdPerson)} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdReviewerPerson)} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdArticle)} />

  <main class="page">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">{SITE.name}</a> <span>/</span>
      <a href="/compliance/">Compliance Alerts</a> <span>/</span>
      <span class="crumb-current">{entry.jurisdiction}</span>
    </nav>

    <header class="hero">
      <div class="hero-tags">
        <span class:list={["badge", `badge--${entry.urgency}`]}>{URGENCY_LABEL[entry.urgency]}</span>
        <span class="badge badge--cat">{entry.category}</span>
        <span class="badge badge--jur">{entry.jurisdiction}</span>
      </div>
      <h1>{entry.h1}</h1>
      <Byline reviewer={reviewer} />
      {paragraphs(entry.intro).map((para) => <p class="lede" set:html={linkify(para)} />)}
    </header>

    <section class="obligation" aria-label="Obligation summary">
      <h2 class="ob-title">What this rule requires — at a glance</h2>
      <dl class="ob-grid">
        <div class="ob-item"><dt>Who must comply</dt><dd>{entry.whoMustComply}</dd></div>
        <div class="ob-item"><dt>What's required</dt><dd>{entry.actionRequired}</dd></div>
        <div class="ob-item"><dt>Effective</dt><dd>{effective}</dd></div>
        {deadline && <div class="ob-item"><dt>Deadline</dt><dd>{deadline}</dd></div>}
        <div class="ob-item"><dt>Penalty for non-compliance</dt><dd>{entry.penalty}</dd></div>
        <div class="ob-item"><dt>Enforcing agency</dt><dd>{entry.agency}</dd></div>
        <div class="ob-item ob-item--wide">
          <dt>The law</dt>
          <dd><a href={entry.citationUrl} rel="noopener noreferrer" target="_blank">{entry.citation}</a></dd>
        </div>
      </dl>
      <p class="ob-cta">Need to be sure your business complies? <a href="#get-help">Get matched with a professional →</a></p>
    </section>

    <section class="section">
      <h2>What changed</h2>
      {paragraphs(entry.whatChanged).map((para) => <p set:html={linkify(para)} />)}
    </section>

    <section class="section">
      <h2>Who is affected</h2>
      {paragraphs(entry.whoIsAffected).map((para) => <p set:html={linkify(para)} />)}
    </section>

    <section class="section">
      <h2>How to comply, step by step</h2>
      <ol class="steps">
        {entry.complianceSteps.map((s) => <li set:html={linkify(s)} />)}
      </ol>
    </section>

    <section class="section">
      <h2>Frequently asked questions</h2>
      <div class="faqs">
        {entry.faqs.map((f) => (
          <details class="faq">
            <summary><h3>{f.question}</h3></summary>
            <p set:html={linkify(f.answer)} />
          </details>
        ))}
      </div>
    </section>

    <LegalDisclaimer scope="legal" />
    <Sources sources={entry.sources} />

    {related.length > 0 && (
      <section class="section">
        <h2>Related compliance alerts</h2>
        <div class="related-grid">
          {related.map((r) => (
            <LinkCard href={`/compliance/${r.slug}/`} title={r.title} meta={`${r.jurisdiction} · ${r.category}`} />
          ))}
        </div>
        <p class="related-all">
          See <a href="/compliance/">all new-law compliance alerts</a> tracked by {SITE.name}.
        </p>
      </section>
    )}

    <ComplianceLeadForm
      pageSlug={`/compliance/${entry.slug}/`}
      obligationCategory={entry.category}
      jurisdiction={entry.jurisdiction}
      recommendedProfessionals={entry.recommendedProfessionals}
    />
    <CrossLinks calcId="compliance" />
  </main>

  <style>
    .page { max-width: 920px; margin: 0 auto; padding: 16px 20px 56px; }
    .crumb { font-size: 0.875rem; color: #666; padding: 8px 0 12px; }
    .crumb a { color: var(--primary-dark); text-decoration: none; }
    .crumb a:hover { text-decoration: underline; }
    .crumb-current { color: #999; }
    .hero { padding: 8px 0 16px; }
    .hero h1 { font-size: 2.3rem; margin: 0 0 14px; line-height: 1.2; }
    .hero-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; }
    .badge {
      display: inline-flex; align-items: center;
      font-size: 0.74rem; font-weight: 700; letter-spacing: 0.02em; text-transform: uppercase;
      padding: 4px 10px; border-radius: 999px;
    }
    .badge--high { color: #8C2B14; background: #FDE8E0; border: 1px solid #F5C4B3; }
    .badge--medium { color: #8A6A00; background: #FCE9B6; border: 1px solid #F0DDA5; }
    .badge--low { color: #33564B; background: #E4F4EF; border: 1px solid #C9E6DC; }
    .badge--cat, .badge--jur { color: #4A5E57; background: #F1F5F3; border: 1px solid #E0E8E4; }
    .lede { font-size: 1.15rem; color: #3a3a3a; margin: 0 0 14px; line-height: 1.7; }
    .lede:last-of-type { margin-bottom: 0; }

    .obligation {
      margin: 8px 0 18px; padding: 22px;
      background: linear-gradient(180deg, #F4FAF8 0%, #FFFFFF 100%);
      border: 1px solid #D8EEE6; border-radius: 18px;
      box-shadow: 0 12px 32px -18px rgba(0,0,0,0.12);
    }
    .ob-title { font-size: 1.15rem; margin: 0 0 16px; color: var(--primary-dark); }
    .ob-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 22px; margin: 0; }
    .ob-item dt { font-size: 0.74rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em; color: #6a7a75; margin-bottom: 3px; }
    .ob-item dd { margin: 0; font-size: 0.98rem; color: #2c2c2c; line-height: 1.55; }
    .ob-item--wide { grid-column: 1 / -1; }
    .ob-item a { color: var(--primary-dark); font-weight: 600; }
    .ob-cta { margin: 18px 0 0; padding-top: 14px; border-top: 1px solid #E4EFEA; font-size: 0.98rem; color: #444; }
    .ob-cta a { color: var(--primary-dark); font-weight: 700; text-decoration: none; }
    .ob-cta a:hover { text-decoration: underline; }

    .section { padding: 26px 0; border-top: 1px solid #EEF2F0; }
    .section > *:last-child { margin-bottom: 0; }
    .section h2 { font-size: 1.5rem; margin: 0 0 16px; }
    .section p { color: #2c2c2c; font-size: 1.05rem; line-height: 1.85; margin: 0 0 18px; }
    .steps { padding-left: 22px; line-height: 1.85; }
    .steps li { margin-bottom: 12px; color: #2c2c2c; padding-left: 4px; }
    .faqs { display: flex; flex-direction: column; gap: 8px; }
    .faq { border: 1px solid #eee; border-radius: 8px; padding: 16px 18px; background: #fff; }
    .faq summary { cursor: pointer; list-style: none; }
    .faq summary::-webkit-details-marker { display: none; }
    .faq summary h3 { display: inline; font-size: 1.02rem; margin: 0; font-weight: 600; }
    .faq[open] summary h3 { color: var(--primary-dark); }
    .faq p { margin: 12px 0 0; color: #2c2c2c; font-size: 1.02rem; line-height: 1.75; }
    .related-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: 12px; }
    .related-all { margin-top: 16px; font-size: 0.95rem; color: #555; }
    @media (max-width: 600px) {
      .hero h1 { font-size: 1.8rem; }
      .section h2 { font-size: 1.28rem; }
      .obligation { padding: 16px; }
      .ob-grid { grid-template-columns: 1fr; }
    }
  </style>
</BaseLayout>
