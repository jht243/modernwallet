---
// Compliance Alerts pillar page — the hub for the "new laws that burden businesses" vertical and
// the anti-orphan root: every live alert renders in the grid below, grouped by category, so every
// spoke page always has at least one inbound internal link. Linked sitewide from the header nav
// and the footer column.
import BaseLayout from "../../layouts/BaseLayout.astro";
import LinkCard from "../../components/LinkCard.astro";
import Byline from "../../components/Byline.astro";
import LegalDisclaimer from "../../components/LegalDisclaimer.astro";
import { SITE, LAST_UPDATED, REVIEWER } from "../../data/site";
import { liveAlerts, alertsByCategory } from "../../data/compliance-alerts";
import { personSchema, reviewerPersonSchema } from "../../lib/jsonld";

const alerts = liveAlerts();
const groups = alertsByCategory();
const canonicalUrl = new URL("/compliance/", Astro.site).toString();

const title = "New-Law Compliance Alerts for Businesses";
const metaDescription =
  "Track new laws and rules that create real obligations for businesses — who must comply, deadlines, penalties, and how to get help from vetted professionals.";

const URGENCY_LABEL = { high: "Act now", medium: "Deadline this year", low: "On the horizon" } as const;

/** "2026-12-31" → "December 31, 2026"; anything non-ISO passes through unchanged. */
function fmtDate(value: string): string {
  if (!/^\d{4}-\d{2}-\d{2}$/.test(value)) return value;
  return new Date(value + "T00:00:00Z").toLocaleDateString("en-US", {
    year: "numeric", month: "long", day: "numeric", timeZone: "UTC",
  });
}

// ---- JSON-LD ----
const jsonLdBreadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: SITE.name, item: new URL("/", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name: "Compliance Alerts", item: canonicalUrl },
  ],
};

const jsonLdCollection = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: title,
  description: metaDescription,
  url: canonicalUrl,
  hasPart: alerts.map((a) => ({
    "@type": "Article",
    headline: a.title,
    url: new URL(`/compliance/${a.slug}/`, Astro.site).toString(),
  })),
};

const jsonLdPerson = personSchema();
const jsonLdReviewerPerson = reviewerPersonSchema(REVIEWER);
---
<BaseLayout title={title} description={metaDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdBreadcrumb)} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdCollection)} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdPerson)} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdReviewerPerson)} />

  <main class="page">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">{SITE.name}</a> <span>/</span>
      <span class="crumb-current">Compliance Alerts</span>
    </nav>

    <header class="hero">
      <h1>New laws create new obligations. Know yours before the deadline.</h1>
      <Byline reviewer={REVIEWER} />
      <p class="lede">
        Every year, new federal and state laws require businesses to file something, register
        something, disclose something, or change how they handle money, employees, and workplaces.
        Each alert below explains one new requirement in plain English — who must comply, by when,
        what non-compliance costs — and connects you with a vetted attorney, CPA, compliance
        consultant, or software solution if you need help.
      </p>
      <div class="hero-legend" aria-label="Urgency legend">
        <span class="badge badge--high">Act now</span>
        <span class="badge badge--medium">Deadline this year</span>
        <span class="badge badge--low">On the horizon</span>
      </div>
    </header>

    {groups.map(([category, list]) => (
      <section class="section">
        <h2>{category}</h2>
        <div class="alert-grid">
          {list.map((a) => (
            <a class="alert-card" href={`/compliance/${a.slug}/`}>
              <span class="ac-tags">
                <span class:list={["badge", `badge--${a.urgency}`]}>{URGENCY_LABEL[a.urgency]}</span>
                <span class="badge badge--jur">{a.jurisdiction}</span>
              </span>
              <span class="ac-title">{a.title}</span>
              <span class="ac-req">{a.actionRequired}</span>
              <span class="ac-meta">
                {a.deadline ? `Deadline: ${fmtDate(a.deadline)}` : `Effective: ${fmtDate(a.effectiveDate)}`}
              </span>
            </a>
          ))}
        </div>
      </section>
    ))}

    <section class="section">
      <h2>How these alerts work</h2>
      <p>
        We monitor newly enacted federal rules and state laws for provisions that create affirmative
        duties for businesses — filings, registrations, disclosures, workplace changes, and new
        recordkeeping. When a law clears that bar, we publish a plain-English explainer citing the
        primary source, reviewed for accuracy. Alerts stay updated as agencies issue guidance,
        deadlines move, or courts weigh in.
      </p>
      <p>
        Running the numbers on a business decision instead? Browse the free
        <a href="/calculators/">{SITE.name} calculators</a> — from
        <a href="/business-loan-payoff/">business loan payoff</a> to
        <a href="/tax-resolution/">tax resolution</a>.
      </p>
    </section>

    <LegalDisclaimer scope="legal" />
  </main>

  <style>
    .page { max-width: 920px; margin: 0 auto; padding: 16px 20px 56px; }
    .crumb { font-size: 0.875rem; color: #666; padding: 8px 0 12px; }
    .crumb a { color: var(--primary-dark); text-decoration: none; }
    .crumb a:hover { text-decoration: underline; }
    .crumb-current { color: #999; }
    .hero { padding: 8px 0 20px; }
    .hero h1 { font-size: 2.3rem; margin: 0 0 14px; line-height: 1.2; }
    .lede { font-size: 1.15rem; color: #3a3a3a; margin: 0 0 16px; line-height: 1.7; }
    .hero-legend { display: flex; flex-wrap: wrap; gap: 8px; }

    .badge {
      display: inline-flex; align-items: center;
      font-size: 0.72rem; font-weight: 700; letter-spacing: 0.02em; text-transform: uppercase;
      padding: 3px 9px; border-radius: 999px;
    }
    .badge--high { color: #8C2B14; background: #FDE8E0; border: 1px solid #F5C4B3; }
    .badge--medium { color: #8A6A00; background: #FCE9B6; border: 1px solid #F0DDA5; }
    .badge--low { color: #33564B; background: #E4F4EF; border: 1px solid #C9E6DC; }
    .badge--jur { color: #4A5E57; background: #F1F5F3; border: 1px solid #E0E8E4; }

    .section { padding: 26px 0; border-top: 1px solid #EEF2F0; }
    .section h2 { font-size: 1.5rem; margin: 0 0 16px; }
    .section p { color: #2c2c2c; font-size: 1.05rem; line-height: 1.85; margin: 0 0 18px; }
    .section p:last-child { margin-bottom: 0; }
    .section a { color: var(--primary-dark); font-weight: 600; }

    .alert-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 400px), 1fr)); gap: 12px; }
    .alert-card {
      display: flex; flex-direction: column; gap: 8px;
      border: 1px solid #E0EFE9; border-radius: 12px; padding: 18px;
      background: #fff; text-decoration: none; color: var(--text);
      transition: border-color 120ms ease, transform 120ms ease, box-shadow 120ms ease;
    }
    .alert-card:hover { border-color: var(--primary); transform: translateY(-1px); box-shadow: 0 8px 20px -12px rgba(0,0,0,0.12); }
    .ac-tags { display: flex; flex-wrap: wrap; gap: 6px; }
    .ac-title { font-weight: 700; font-size: 1.05rem; line-height: 1.3; }
    .ac-req { font-size: 0.9rem; color: #4a5a55; line-height: 1.5; }
    .ac-meta { font-size: 0.82rem; color: #7a8a85; font-weight: 600; }
    @media (max-width: 600px) { .hero h1 { font-size: 1.8rem; } .section h2 { font-size: 1.28rem; } }
  </style>
</BaseLayout>
