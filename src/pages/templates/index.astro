---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE } from "../../data/site";
import { TEMPLATES } from "../../data/templates";

const canonicalUrl = new URL("/templates/", Astro.site).toString();
const jsonLdBreadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: SITE.name, item: new URL("/", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name: "Templates", item: canonicalUrl },
  ],
};
const jsonLdList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  itemListElement: TEMPLATES.map((t, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: t.h1,
    url: new URL(`/templates/${t.slug}/`, Astro.site).toString(),
  })),
};
---
<BaseLayout
  title={`Free Business Templates for Freelancers — ${SITE.name}`}
  description="Free, editable templates for freelancers and the self-employed: invoices, contracts, statements of work, retainers, mileage logs, and expense reports."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdBreadcrumb)} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdList)} />

  <main class="page">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">{SITE.name}</a> <span>/</span>
      <span class="crumb-current">Templates</span>
    </nav>

    <header class="hero">
      <h1>Free templates for the self-employed</h1>
      <p class="lede">
        Editable Word and spreadsheet templates for the paperwork of freelancing — invoicing,
        contracts, and the records that turn into a Schedule C. Free to download, no email required.
      </p>
    </header>

    <div class="grid">
      {TEMPLATES.map((t) => (
        <a class="tcard" href={`/templates/${t.slug}/`}>
          <span class="tcard-format">{t.file.format}</span>
          <span class="tcard-title">{t.h1}</span>
          <span class="tcard-blurb">{t.cardBlurb}</span>
        </a>
      ))}
    </div>
  </main>

  <style>
    .page { max-width: 1000px; margin: 0 auto; padding: 16px 20px 56px; }
    .crumb { font-size: 0.875rem; color: #666; padding: 8px 0 12px; }
    .crumb a { color: var(--primary-dark); text-decoration: none; }
    .crumb-current { color: #999; }
    .hero { padding: 8px 0 18px; border-bottom: 1px solid #eee; margin-bottom: 20px; }
    .hero h1 { font-size: 2.4rem; margin: 0 0 12px; line-height: 1.2; }
    .lede { font-size: 1.15rem; color: #444; max-width: 720px; line-height: 1.6; margin: 0; }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 16px; }
    .tcard { display: flex; flex-direction: column; gap: 8px; padding: 22px; border: 1px solid #E0EFE9; border-radius: 14px; background: #fff; text-decoration: none; color: var(--text); transition: border-color 120ms ease, transform 120ms ease, box-shadow 120ms ease; }
    .tcard:hover { border-color: var(--primary); transform: translateY(-1px); box-shadow: 0 8px 20px -12px rgba(0,0,0,0.12); }
    .tcard-format { align-self: flex-start; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.05em; color: var(--primary-dark); background: #EAF7F1; border: 1px solid #CFE9DE; border-radius: 999px; padding: 3px 9px; }
    .tcard-title { font-weight: 700; font-size: 1.1rem; line-height: 1.3; }
    .tcard-blurb { font-size: 0.92rem; color: #555; line-height: 1.5; }
    @media (max-width: 600px) { .hero h1 { font-size: 1.9rem; } }
  </style>
</BaseLayout>
