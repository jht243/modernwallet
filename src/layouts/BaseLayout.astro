---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { SITE } from "../data/site";

export interface Props {
  title: string;
  description: string;
  canonical?: string;
}
const { title, description, canonical } = Astro.props;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();

// Sitewide Organization JSON-LD (brand entity for SEO).
const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: SITE.name,
  url: new URL("/", Astro.site).toString(),
  logo: { "@type": "ImageObject", url: new URL("/favicon.svg", Astro.site).toString() },
  description: SITE.description,
};
---
<!doctype html>
<html lang="en">
  <head>
    <!-- Google AdSense -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9221731580537826" crossorigin="anonymous" is:inline></script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-GLEBF3S7CQ" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-GLEBF3S7CQ');
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    <style is:global>
      :root {
        --primary: #0E7C66;
        --primary-dark: #0a5f4e;
        --accent: #E0A43B;
        --bg: #FAFCFB;
        --text: #1A1A1A;
        --muted: #5b6b66;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; background: var(--bg); color: var(--text); }
      body { max-width: 100%; overflow-x: hidden; }
      img, video { max-width: 100%; height: auto; }
      a { color: var(--primary-dark); }
      h1, h2, h3 { letter-spacing: -0.01em; }
      /* Mobile-only: keep form controls at 16px so iOS Safari never zoom-jumps on focus. Desktop unaffected. */
      @media (max-width: 768px) {
        input, select, textarea { font-size: 16px; }
      }
    </style>
  </head>
  <body>
    <SiteHeader />
    <slot />
    <SiteFooter />
  </body>
</html>
