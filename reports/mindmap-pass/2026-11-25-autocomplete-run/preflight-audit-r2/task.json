  "findings": [
    {
      "id": "A1-N1",
      "status": "open",
      "evidence": "Equal-rate and smallest-is-highest examples omit their minimum payments ($90/$180 and $50/$200), so readers cannot reproduce $2,464.56 and $1,611.43 without the evidence file. Add the minimums in a later pass."
    },
    {
      "id": "A3-F1",
      "status": "open",
      "evidence": "Banned or inflated words. Fix in place: Publisher note \"prevents significant projection errors\" -> \"prevents projection errors\"; \"A critical mathematical condition applies:\" -> \"One condition applies:\"; \"updates its foundational financial argument conventions\" -> \"changes how its FV function takes arguments\"."
    },
    {
      "id": "A3-F2",
      "status": "open",
      "evidence": "Overclaimed exactness. Fix: \"produces an exact future value (FV) of $16,470.09\" -> \"produces a future value (FV) of $16,470.09\"; \"yields exactly $16,470.09\" -> \"yields $16,470.09\"; FAQ \"produces exactly $16,436.19\" -> \"produces $16,436.19\"."
    },
    {
      "id": "A3-F3",
      "status": "open",
      "evidence": "=FV(0.00417507,12*10,-200,-10000) returns $47,559.86 not $47,559.87 and the gap vs $47,526.55 is $33.31. Fix: use the unrounded effective rate wording \"about $47,559.87\" and \"about $33\" or print the rate to 10 digits (0.0041750727)."
    },
    {
      "id": "R1-2-checks-wholePageCoherence",
      "status": "open",
      "evidence": "Coherent answer and takeaway, same-frequency condition stated in opener and takeaway as required by CR7, but wording overclaims exactness and uses banned filler words."
    },
    {
