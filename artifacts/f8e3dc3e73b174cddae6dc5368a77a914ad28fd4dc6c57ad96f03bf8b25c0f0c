                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "No. This page provides general federal tax information based on the tax year 2025 Form 8606 instructions. It is not personal tax advice. A qualified tax professional can help you apply these rules to your specific tax return."
                }
