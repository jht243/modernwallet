xpanded="false" aria-controls="ns-results" data-astro-cid-x4l6pap7> <button class="ns__close" type="button" aria-label="Close search" data-astro-cid-x4l6pap7>&times;</button> </div> <div class="ns__results" id="ns-results" role="listbox" data-astro-cid-x4l6pap7></div> </div> </div>   </nav> </div> </header>    <script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"ModernWallet","item":"https://www.themodernwallet.com/"},{"@type":"ListItem","position":2,"name":"Guides","item":"https://www.themodernwallet.com/guides/"},{"@type":"ListItem","position":3,"name":"Health Account Reimbursement Checklist","item":"https://www.themodernwallet.com/guides/hsa-fsa-reimbursement-checklist/"}]}</script> <script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Can I reimburse myself out of my HSA?","acceptedAnswer":{"@type":"Answer","text":"Yes, you can reimburse yourself out of your HSA for qualified medical expenses incurred after the account was established under state law. You must maintain records showing the expenses were not reimbursed by insurance or other sources and were not claimed as an itemized deduction on your tax return."}},{"@type":"Question","name":"Does HSA reimbursement require a receipt?","acceptedAnswer":{"@type":"Answer","text":"Yes, IRS rules require you to keep receipts and documentation showing your distributions were used exclusively to pay or reimburse qualified medical expenses. You do not submit these receipts with your tax return, but you must retain them in your tax records to substantiate distributions reported on Form 8889."}},{"@type":"Question","name":"Can an FSA reimburse an expense before the service happens?","acceptedAnswer":{"@type":"Answer","text":"No, an FSA cannot advance reimburse future or projected expenses. Under IRS Publication 969, expenses are only eligible for FSA reimbursement after the medical care has actually been provided during your active coverage period."}},{"@type":"Question","name":"Can I reimburse a medical membership fee?","acceptedAnswer":{"@type":"Answer","text":"A medical membership fee can only be reimbursed if it meets specific federal tax criteria. Fees for general health improvement or arrangements paid by employer contributions do not qualify."}}]}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"Person","name":"Jonathan Velez","url":"https://www.themodernwallet.com/about/","jobTitle":"Personal Finance Writer & Editor","description":"Jonathan Velez writes and edits ModernWallet's personal-finance content, focused on loans, interest, and debt payoff. Every calculator page is reviewed against primary sources like the CFPB and Federal Reserve.","knowsAbout":["Auto loans","Loan amortization","Interest and APR","Debt payoff strategies","Personal finance"],"worksFor":{"@type":"Organization","name":"ModernWallet","url":"https://www.themodernwallet.com"}}</script> <script type="application/ld+json">{"@context":"https://schema.org","@type":"Article","headline":"Health Account Reimbursement Checklist","description":"Prepare a health savings account (HSA) or flexible spending account (FSA) claim with itemized records, timing checks and no duplicate reimbursement.","url":"https://www.themodernwallet.com/guides/hsa-fsa-reimbursement-checklist/","image":{"@type":"ImageObject","url":"https://www.themodernwallet.com/favicon.svg"},"datePublished":"2026-11-09","dateModified":"2026-11-09","author":{"@type":"Person","name":"Jonathan Velez","url":"https://www.themodernwallet.com/about/"},"publisher":{"@type":"Organization","name":"ModernWallet","url":"https://www.themodernwallet.com","logo":{"@type":"ImageObject","url":"https://www.themodernwallet.com/favicon.svg"}},"citation":[{"@type":"CreativeWork","name":"IRS Publication 969, Health Savings Accounts and Other Tax-Favored Health Plans","url":"https://www.irs.gov/publications/p969"},{"@type":"CreativeWork","name":"IRS Publication 502, Medical and Dental Expenses","url":"https://www.irs.gov/publications/p502"},{"@type":"CreativeWork","name":"IRS Notice 2026-5, Internal Revenue Bulletin 2026-02","url":"https://www.irs.gov/irb/2026-02_IRB"}]}</script> <main class="page" data-astro-cid-2u677oxp> <nav class="crumb" aria-label="Breadcrumb" data-astro-cid-2u677oxp> <a href="/" data-astro-cid-2u677oxp>ModernWallet</a> <span data-astro-cid-2u677oxp>/</span> <a href="/guides/" data-astro-cid-2u677oxp>Guides</a> <span data-astro-cid-2u677oxp>/</span> <span class="crumb-current" data-astro-cid-2u677oxp>Health Account Reimbursement Checklist</span> </nav> <header class="hero" data-astro-cid-2u677oxp> <h1 data-astro-cid-2u677oxp>Health Account Reimbursement Checklist</h1> <div class="byline" data-astro-cid-oxbng3yr> <span class="by" data-astro-cid-oxbng3yr>By <a href="/about/" data-astro-cid-oxbng3yr>Jonathan Velez</a>, Personal Finance Writer &amp; Editor</span> <span class="sep" aria-hidden="true" data-astro-cid-oxbng3yr>·</span> <span class="rev" data-astro-cid-oxbng3yr>Reviewed against primary sources · Updated November 9, 2026</span> </div>   <p class="lede" data-astro-cid-2u677oxp>To prepare a health account reimbursement claim, match an itemized medical record to your coverage dates, confirm no other plan paid the balance, and follow your account administrator's instructions. A health savings account (HSA) and a health flexible spending arrangement (FSA) handle distributions under different federal tax rules.</p><p class="lede" data-astro-cid-2u677oxp>In the <a href="/guides/">money guides</a> we publish, our approach starts directly with primary rules from the <a href="https://www.irs.gov/publications/p969" target="_blank" rel="noopener">Internal Revenue Service (IRS)</a>.</p><p class="lede" data-astro-cid-2u677oxp>An HSA reimburses qualified medical expenses incurred after the account is established under state law. You keep the records with your tax files rather than submitting every receipt to the government.</p><p class="lede" data-astro-cid-2u677oxp>An FSA reimburses qualified expenses incurred during your actual period of coverage and requires written substantiation from an independent third party before payment.</p><p class="lede" data-astro-cid-2u677oxp>Neither account permits double reimbursement. If health insurance or another party paid a portion of the bill, only your remaining out-of-pocket share qualifies for reimbursement.</p><p class="lede" data-astro-cid-2u677oxp>You also cannot claim an itemized medical deduction on Schedule A (Form 1040) for any medical expense paid with tax-free funds from an HSA or an FSA.</p> </header> <section class="tools" aria-label="Tools for this journey" data-astro-cid-2u677oxp> <span class="tools-title" data-astro-cid-2u677oxp>Tools for this journey</span> <div class="tool-pills" data-astro-cid-2u677oxp> <a class="tool-pill" href="https://www.irs.gov/publications/p969" data-astro-cid-2u677oxp>IRS Reimbursement Rules<span class="arrow" aria-hidden="true" data-astro-cid-2u677oxp>→</span></a> </div> </section> <nav class="benefits-toc" aria-label="On This Page" data-astro-cid-2u677oxp><strong data-astro-cid-2u677oxp>On This Page</strong><ol data-astro-cid-2u677oxp><li data-astro-cid-2u677oxp><a href="#benefits-section-1" data-astro-cid-2u677oxp>Reimbursement Checklist Before You File</a></li><li data-astro-cid-2u677oxp><a href="#benefits-section-2" data-astro-cid-2u677oxp>Records for Your Reimbursement Checklist</a></li><li data-astro-cid-2u677oxp><a href="#benefits-section-3" data-astro-cid-2u677oxp>HSA Expense Timing and Recordkeeping</a></li><li data-astro-cid-2u677oxp><a href="#benefits-section-4" data-astro-cid-2u677oxp>FSA Coverage and Substantiation</a></li><li data-astro-cid-2u677oxp><a href="#benefits-section-5" data-astro-cid-2u677oxp>Membership Fees Need a Separate Check</a></li><li data-astro-cid-2u677oxp><a href="#benefits-section-6" data-astro-cid-2u677oxp>Submit One Claim and Save the Result</a></li><li data-astro-cid-2u677oxp><a href="#benefits-section-7" data-astro-cid-2u677oxp>Finish Your Reimbursement Checklist</a></li></ol></nav>  <section class="section" data-astro-cid-2u677oxp> <h2 id="benefits-section-1" data-astro-cid-2u677oxp>Reimbursement Checklist Before You File</h2> <p>Before you request an HSA distribution or submit an FSA claim, walk through these six steps in order:</p>
<ol class="prose-list"><li>Obtain an itemized bill or provider statement showing the patient name, provider name, date of service, service description, and amount charged.</li><li>Verify timing against account rules, confirming your HSA was already established when the expense occurred, or that the expense fell within your active FSA coverage period.</li><li>Subtract all insurance payments, provider discounts, and outside reimbursements to calculate your remaining out-of-pocket responsibility.</li><li>Check that you have not previously reimbursed this amount through another account or claimed it as an itemized deduction on Schedule A.</li><li>Match the claim against your specific account requirements, submitting third-party substantiation for an FSA or logging the records into your tax files for an HSA.</li><li>Save the submission confirmation, administrator response, and actual reimbursement record alongside your itemized invoices.</li></ol>
<p>Taking these steps in sequence prevents duplicate claims and ensures your records align with federal tax rules.</p> </section>  <section class="section" data-astro-cid-2u677oxp> <h2 id="benefits-section-2" data-astro-cid-2u677oxp>Records for Your Reimbursement Checklist</h2> <p>A complete reimbursement checklist relies on documentation that demonstrates what care was provided, who received it, when it occurred, and how much you paid. Do not rely on a generic payment receipt that only lists a total charge.</p>
<div class="table-wrap"><table class="prose-table"><thead><tr><th scope="col">Document field</th><th scope="col">Practical purpose</th></tr></thead><tbody><tr><th scope="row">Provider or facility name</th><td>Identifies the independent party that delivered the care or medical product</td></tr><tr><th scope="row">Patient name</th><td>Shows the expense was incurred for an eligible individual</td></tr><tr><th scope="row">Item or service description</th><td>Establishes whether the expense represents diagnosis, cure, mitigation, treatment, or prevention of disease</td></tr><tr><th scope="row">Date of service or purchase</th><td>Confirms the expense occurred within the allowable HSA or FSA timing window</td></tr><tr><th scope="row">Total charge and patient responsibility</th><td>Shows the exact unreimbursed dollar amount owed after any adjustments</td></tr></tbody></table></div>
<p>For expenses processed through health insurance, an Explanation of Benefits (EOB) provides helpful documentation. An EOB details what the provider billed, the portion paid by insurance, and your final responsibility.</p>
<p>An EOB alone does not serve as proof of payment, so retain your final payment receipt as well.</p>
<p>Keep documentation showing you paid the remaining balance. If an invoice bundles multiple items together, request an itemized statement from your provider so that each individual charge is visible.</p> </section>  <section class="section" data-astro-cid-2u677oxp> <h2 id="benefits-section-3" data-astro-cid-2u677oxp>HSA Expense Timing and Recordkeeping</h2> <p><a href="https://www.irs.gov/publications/p969" target="_blank" rel="noopener">IRS Publication 969</a> states that an HSA can pay or reimburse qualified medical expenses incurred after the account is established. State law determines when an HSA is established, and a rollover account may inherit an earlier establishment date.</p>
<p>Contact your HSA custodian if you need to confirm your formal account establishment records.</p>
<p>You do not mail receipts to the IRS when you withdraw money from an HSA. Instead, you report total distributions on Form 8889 with your annual tax return. <a href="https://www.irs.gov/publications/p969" target="_blank" rel="noopener">IRS Publication 969</a> requires you to keep records in your personal files showing that all distributions paid exclusive qualified medical expenses.</p>
<p>Your HSA records must establish three things:</p>
<ul class="prose-list"><li>The distributions paid or reimbursed qualified medical expenses incurred after the account was established.</li><li>The medical expenses were not previously paid or reimbursed from another source.</li><li>You did not claim the expenses as an itemized deduction on Schedule A in any tax year.</li></ul>
<p>Expense timing carries one narrow conditional exception. Under <a href="https://www.irs.gov/irb/2026-02_IRB" target="_blank" rel="noopener">IRS Notice 2026-5, Internal Revenue Bulletin 2026-02</a>, question 19 explains that an HSA may treat a substantiated fee for a qualifying direct primary care service arrangement (DPCSA) as incurred on the first day of each month pro rata, the first day of the coverage period, or the date the fee is paid.</p>
<p>This rule generally permits reimbursement of substantiated periodic fees before the associated coverage begins, provided the arrangement satisfies all statutory criteria. That flexibility applies strictly to qualifying arrangements under HSA rules and does not alter timing requirements for an FSA.</p> </section>  <section class="section" data-astro-cid-2u677oxp> <h2 id="benefits-section-4" data-astro-cid-2u677oxp>FSA Coverage and Substantiation</h2> <p>A health FSA operates under distinct statutory constraints. <a href="https://www.irs.gov/publications/p969" target="_blank" rel="noopener">IRS Publication 969</a> explains that health FSA distributions generally reimburse qualified medical expenses incurred during your actual period of coverage.</p>
<p>An FSA cannot advance reimburse future or projected expenses. You must receive the medical care before an FSA can issue reimbursement.</p>
<p>Plan documents determine whether your employer offers a grace period or carryover provision, so review your plan materials for your specific claim submission deadline.</p>
<p>Substantiating an FSA claim requires written statements from an independent third party showing that the medical expense was incurred and listing the exact amount. The employee must also provide a written statement confirming the expense has not been paid or reimbursed by any other health plan.</p>
<p>When you use an FSA debit card, certain transactions meeting automated substantiation methods do not require additional documentation. Paying with a card does not guarantee that substantiation is complete, and your plan administrator may still request an itemized invoice.</p>
<p>Always save your receipts until your administrator confirms the expense is approved.</p> </section>  <section class="section" data-astro-cid-2u677oxp> <h2 id="benefits-section-5" data-astro-cid-2u677oxp>Membership Fees Need a Separate Check</h2> <p>Fixed periodic medical membership fees require careful analysis before you submit a claim or withdraw funds. An itemized invoice or provider marketing statement does not automatically transform a nonqualified membership fee into a qualified medical expense.</p>
<p><a href="https://www.irs.gov/publications/p502" target="_blank" rel="noopener">IRS Publication 502</a> clarifies that expenses qualifying for tax-free medical spending are those paid for the diagnosis, cure, mitigation, treatment, or prevention of disease, or for affecting any structure or function of the body.</p>
<p>Amounts spent for general health improvement are excluded. If an agreement bundles administrative services, wellness benefits, and clinical access together, request an itemized description of included services from the organization to determine what care was delivered.</p>
<p>For an HSA, question 20 of <a href="https://www.irs.gov/irb/2026-02_IRB" target="_blank" rel="noopener">IRS Notice 2026-5, Internal Revenue Bulletin 2026-02</a> defines a qualifying DPCSA as an arrangement where an individual receives solely primary care medical services provided by qualifying primary care practitioners in exchange for a fixed periodic fee. The arrangement cannot include procedures requiring general anesthesia, prescription drugs other than vaccines, or laboratory tests not typically administered in an ambulatory primary care setting.</p>
<p>Question 20 notes there is no specific dollar cap on fees eligible for HSA reimbursement under this rule, though contribution eligibility remains separate. Question 18 of <a href="https://www.irs.gov/irb/2026-02_IRB" target="_blank" rel="noopener">IRS Notice 2026-5, Internal Revenue Bulletin 2026-02</a> notes that employer-paid DPCSA fees, including salary reduction contributions under a cafeteria plan, are not considered beneficiary-paid expenses and cannot be reimbursed from an HSA.</p>
<p>If an arrangement fails to satisfy these conditions, the fee does not qualify for tax-free reimbursement.</p> </section>  <section class="section" data-astro-cid-2u677oxp> <h2 id="benefits-section-6" data-astro-cid-2u677oxp>Submit One Claim and Save the Result</h2> <p>To file your claim, follow the specific submission steps provided by your account custodian or third-party administrator.</p>
<p>When filing an FSA claim, upload your independent third-party statement and complete the required certification that no other plan has reimbursed the balance. For an HSA, follow your custodian's platform instructions to request a distribution.</p>
<p>After submitting documentation, retain the following records:</p>
<ul class="prose-list"><li>The submission confirmation number or upload receipt.</li><li>A copy of all itemized statements and explanations of benefits provided.</li><li>The administrator's approval or payment statement.</li><li>The actual reimbursement record.</li></ul>
<p>If your administrator flags an expense due to missing details, request an itemized invoice directly from your medical provider. A confirmation receipt acknowledges that paperwork was received, but it does not guarantee claim approval or tax-free status.</p> </section>  <section class="section" data-astro-cid-2u677oxp> <h2 id="benefits-section-7" data-astro-cid-2u677oxp>Finish Your Reimbursement Checklist</h2> <p>Completing a health account reimbursement requires matching verified documents to applicable tax regulations. Start by assembling the itemized records for a single expense, confirm your account establishment date or coverage window, and verify that no other coverage has paid the bill.</p>
<p>If an expense involves bundled services, questionable qualification, or incomplete receipts, pause the reimbursement. Review the relevant federal criteria in <a href="https://www.irs.gov/publications/p969" target="_blank" rel="noopener">IRS Publication 969</a> and <a href="https://www.irs.gov/publications/p502" target="_blank" rel="noopener">IRS Publication 502</a> before withdrawing funds or filing claims.</p>
<p>Take the next action on your reimbursement checklist by requesting an itemized invoice for your most recent unreimbursed medical expense and checking your account timing rules.</p> </section>  <section class="section" data-astro-cid-2u677oxp> <h2 data-astro-cid-2u677oxp>Frequently Asked Questions</h2> <div class="faqs" data-astro-cid-2u677oxp> <details class="faq" data-astro-cid-2u677oxp> <summary data-astro-cid-2u677oxp><h3 data-astro-cid-2u677oxp>Can I reimburse myself out of my HSA?</h3></summary> <p data-astro-cid-2u677oxp>Yes, you can reimburse yourself out of your HSA for qualified medical expenses incurred after the account was established under state law. You must maintain records showing the expenses were not reimbursed by insurance or other sources and were not claimed as an itemized deduction on your tax return.</p> </details><details class="faq" data-astro-cid-2u677oxp> <summary data-astro-cid-2u677oxp><h3 data-astro-cid-2u677oxp>Does HSA reimbursement require a receipt?</h3></summary> <p data-astro-cid-2u677oxp>Yes, IRS rules require you to keep receipts and documentation showing your distributions were used exclusively to pay or reimburse qualified medical expenses. You do not submit these receipts with your tax return, but you must retain them in your tax records to substantiate distributions reported on Form 8889.</p> </details><details class="faq" data-astro-cid-2u677oxp> <summary data-astro-cid-2u677oxp><h3 data-astro-cid-2u677oxp>Can an FSA reimburse an expense before the service happens?</h3></summary> <p data-astro-cid-2u677oxp>No, an FSA cannot advance reimburse future or projected expenses. Under IRS Publication 969, expenses are only eligible for FSA reimbursement after the medical care has actually been provided during your active coverage period.</p> </details><details class="faq" data-astro-cid-2u677oxp> <summary data-astro-cid-2u677oxp><h3 data-astro-cid-2u677oxp>Can I reimburse a medical membership fee?</h3></summary> <p data-astro-cid-2u677oxp>A medical membership fee can only be reimbursed if it meets specific federal tax criteria. Fees for general health improvement or arrangements paid by employer contributions do not qualify.</p> </details> </div> </section>  <section class="section sources" data-astro-cid-3ntd4h4x><h2 data-astro-cid-3ntd4h4x>Sources</h2><p class="source-note" data-astro-cid-3ntd4h4x>
