---
import BaseLayout from "../layouts/BaseLayout.astro";
import { EDITORIAL_DESK, EDITORIAL_REVIEWER, OPERATOR, SITE } from "../data/site";
import { personSchema } from "../lib/jsonld";

const canonicalUrl = new URL("/about/", Astro.site).toString();
const jsonLdPerson = personSchema();
const jsonLdBreadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: SITE.name, item: new URL("/", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name: "About", item: canonicalUrl },
  ],
};
---
<BaseLayout
  title={`About ${SITE.name} — Editorial Leadership & Review Standards`}
  description={`Who runs ${SITE.name}, how our Research Desk builds financial calculators, and how Publisher & Editorial Reviewer ${EDITORIAL_REVIEWER.displayName} oversees accuracy.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdPerson)} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdBreadcrumb)} />

  <main class="page">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">{SITE.name}</a> <span>/</span>
      <span class="crumb-current">About</span>
    </nav>

    <header class="hero">
      <h1>About {SITE.name}</h1>
      <p class="lede">{SITE.name} builds free, accurate financial calculators that show the math behind the answer — no signup, no fluff.</p>
    </header>

    <section class="section">
      <h2>Who operates {SITE.name}</h2>
      <p>
        {SITE.name} is published by <a href={OPERATOR.url} target="_blank" rel="noopener">{OPERATOR.name}</a>.
        The site focuses on free financial calculators and educational finance content for readers
        who want to understand the math behind loans, savings, investing, retirement, budgeting,
        and net worth decisions.
      </p>
    </section>

    <section class="section">
      <h2>How we separate writing from editorial review</h2>
      <p>
        <strong>Author — {EDITORIAL_DESK.name}:</strong> {EDITORIAL_DESK.description}
      </p>
      <p>
        <strong>Editorial Oversight — {EDITORIAL_REVIEWER.displayName}:</strong> Editorial standards,
        formula transparency, and source verification are overseen independently by our publisher and
        editorial reviewer so no page relies on unverified secondary blogs.
      </p>
      <p>Our calculators are educational tools, not personalized financial advice. For decisions specific to your situation, consult a licensed professional.</p>
      <p class="policy-links">
        Read our <a href="/editorial-policy/">how we review &amp; editorial policy</a> and
        <a href="/methodology/">calculator methodology</a>.
      </p>
    </section>

    <section class="section author">
      <h2>Publisher &amp; Editorial Reviewer</h2>
      <div class="author-card">
        <img
          src={EDITORIAL_REVIEWER.imagePath}
          alt={EDITORIAL_REVIEWER.displayName}
          width="72"
          height="72"
          class="avatar-img"
        />
        <div>
          <p class="aname"><a href={EDITORIAL_REVIEWER.path}>{EDITORIAL_REVIEWER.displayName}</a></p>
          <p class="arole">{EDITORIAL_REVIEWER.role} · {EDITORIAL_REVIEWER.credentialSummary}</p>
          <p class="abio">{EDITORIAL_REVIEWER.bio}</p>
          <p class="aknows"><strong>Focus areas:</strong> {EDITORIAL_REVIEWER.knowsAbout.join(", ")}.</p>
          <p class="alinks">
            <a href={EDITORIAL_REVIEWER.path}>Full reviewer profile</a> ·{" "}
            <a href="https://www.jonathanteplitsky.com/" target="_blank" rel="noopener">jonathanteplitsky.com &nearr;</a> ·{" "}
            <a href="https://www.linkedin.com/in/jonathanteplitsky/" target="_blank" rel="noopener">LinkedIn &nearr;</a>
          </p>
        </div>
      </div>
    </section>
  </main>

  <style>
    .page { max-width: 820px; margin: 0 auto; padding: 16px 20px 56px; }
    .crumb { font-size: 0.875rem; color: #666; padding: 8px 0 12px; }
    .crumb a { color: var(--primary-dark); text-decoration: none; }
    .crumb-current { color: #999; }
    .hero { padding: 8px 0 16px; }
    .hero h1 { font-size: 2.3rem; margin: 0 0 12px; }
    .lede { font-size: 1.12rem; color: #444; line-height: 1.6; margin: 0; }
    .section { padding: 17px 0 12px; border-top: 1px solid #EEF2F0; }
    .section h2 { font-size: 1.45rem; margin: 0 0 12px; }
    .section p { color: #333; line-height: 1.7; max-width: 720px; }
    .author-card { display: flex; gap: 18px; align-items: flex-start; }
    .avatar-img { flex-shrink: 0; width: 72px; height: 72px; border-radius: 50%; object-fit: cover; border: 2px solid #d9e6e0; }
    .aname { font-weight: 700; font-size: 1.15rem; margin: 0; }
    .aname a { color: inherit; text-decoration: none; }
    .aname a:hover { text-decoration: underline; }
    .arole { color: var(--primary-dark); font-weight: 600; margin: 2px 0 8px; font-size: 0.94rem; }
    .abio, .aknows, .alinks { margin: 8px 0 0; }
    .alinks a { color: var(--primary-dark); font-weight: 600; text-decoration: none; }
    .alinks a:hover { text-decoration: underline; }
    @media (max-width: 600px) {
      .hero h1 { font-size: 1.85rem; }
      .author-card { flex-direction: column; }
    }
  </style>
</BaseLayout>
