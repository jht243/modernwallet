            "@context": "https://schema.org",
            "@type": "FAQPage",
            "mainEntity": [
              {
                "@type": "Question",
                "name": "What is the current interest rate on I bonds?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "The current interest rate on Series I savings bonds is 5.51% for bonds issued between November 1, 2026 and April 30, 2027. This rate includes a permanent 1.40% fixed rate and a 2.04% semiannual inflation rate. The rate applies for the first six months after you buy the bond."
                }
              },
              {
                "@type": "Question",
                "name": "Is it better to buy EE or I savings bonds?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Series I bonds currently offer a 5.51% composite rate that adjusts for inflation, while Series EE bonds issued between November 1, 2026 and April 30, 2027 offer a 2.90% fixed rate. You can read our detailed side-by-side comparison in I bonds vs EE bonds."
                }
              },
              {
                "@type": "Question",
                "name": "Which bond is paying 7.5% interest?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "No Series I savings bond issued today pays 7.5% interest. In TreasuryDirect's current rate table, older I bonds bought between November 1999 and April 2000, as well as November 2000 to April 2001, earn a 7.55% composite rate, while bonds bought between May 2000 and October 2000 earn 7.75%."
                }
              },
              {
                "@type": "Question",
                "name": "Which bonds give 12% return?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "No U.S. savings bond currently pays a 12% return. The current composite rate for new purchases through April 30, 2027 is 5.51%."
                }
              },
              {
                "@type": "Question",
                "name": "How much is a $1,000 savings bond worth after 30 years?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "The exact value of a $1,000 savings bond after 30 years depends entirely on its issue date, bond series, and historical interest rate adjustments. TreasuryDirect does not publish a single value for all 30-year bonds because each issue period earns different rates over time. You can look up the value of a specific bond in your TreasuryDirect account or its Savings Bond Calculator."
                }
              },
              {
                "@type": "Question",
                "name": "Are I bonds still earning interest?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Yes, Series I savings bonds earn interest continuously for up to 30 years from their issue date, or until you cash them in. Twice a year the earned interest is added to the principal and the new rate applies to the larger value (semiannual compounding). Once an I bond reaches 30 years of age, it stops earning interest."
                }
              },
              {
                "@type": "Question",
                "name": "When can I cash in an I bond?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "You can cash in a Series I savings bond after holding it for 12 months. If you redeem your bond before 5 years, you forfeit the last 3 months of interest as an early redemption penalty. Once you hold the bond for 5 years or longer, you can cash it out at any time without penalty."
                }
              },
              {
                "@type": "Question",
                "name": "Is I bond interest taxable?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Series I bond interest is subject to federal income tax, but it is exempt from all state and local income taxes according to TreasuryDirect tax guidelines. You can report the interest annually or defer reporting it until you cash the bond or it reaches maturity. Using bond proceeds for qualified higher education expenses may allow you to exclude the interest from federal income tax under specific TreasuryDirect higher education rules."
                }
              },
              {
                "@type": "Question",
                "name": "Is this financial advice?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "No. This guide provides general educational information based on published data retrieved from TreasuryDirect on November 18, 2026, and does not constitute financial, investment, or tax advice. Series I savings bond rates are set by the U.S. Department of the Treasury and change on May 1 and November 1 of each year."
                }
              }
            ]
