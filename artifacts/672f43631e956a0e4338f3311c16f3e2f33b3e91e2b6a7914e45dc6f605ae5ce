            "@context": "https://schema.org",
            "@type": "FAQPage",
            "mainEntity": [
              {
                "@type": "Question",
                "name": "Should my 401(k) contributions be Roth?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "You should choose Roth contributions if you expect your marginal tax rate in retirement to equal or exceed your current tax rate. A Roth 401(k) allows your investments to grow tax-free and provides tax-free withdrawals in retirement. If you expect your tax rate to decrease significantly after you stop working, pre-tax contributions may save you more total money."
                }
              },
              {
                "@type": "Question",
                "name": "Can I do a Roth 401(k) and a traditional 401(k)?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Yes, you can split your contributions between a Roth 401(k) and a traditional pre-tax 401(k) in any proportion your employer plan permits. However, your combined contributions across both account types cannot exceed the annual elective deferral limit. For 2026, the combined limit is $24,500 for employees under age 50."
                }
              },
              {
                "@type": "Question",
                "name": "How much can I contribute to my Roth 401(k) per year?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "For 2026, the employee elective deferral limit is $24,500 across both Roth and pre-tax 401(k) accounts. Workers aged 50 and older can make an additional catch-up contribution of $8,000, bringing their total 2026 limit to $32,500. Most plans allow participants aged 60, 61, 62, and 63 to contribute a higher catch-up amount of $11,250 instead of $8,000."
                }
              },
              {
                "@type": "Question",
                "name": "Does a Roth 401(k) have required minimum distributions?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "No, a Roth 401(k) does not require minimum distributions while the account owner is alive. Official IRS guidance confirms that designated Roth accounts are exempt from lifetime RMD rules. However, required distribution rules do apply to beneficiaries who inherit the account after the owner dies."
                }
              },
              {
                "@type": "Question",
                "name": "Is there an income limit for a Roth 401(k)?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "No, there is no income limit for contributing to a Roth 401(k). Unlike a Roth IRA, which phases out eligibility for high earners, any employee eligible to participate in an employer 401(k) plan that offers designated Roth accounts can make Roth contributions regardless of how much they earn."
                }
              },
              {
                "@type": "Question",
                "name": "Is a Roth 401(k) taxed now or later?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "A Roth 401(k) is taxed now. Contributions are made from after-tax payroll deductions and are included in your gross taxable income in the year you make them. In exchange, qualified distributions of both contributions and investment earnings are completely tax-free later in retirement."
                }
              },
              {
                "@type": "Question",
                "name": "Is this tax advice?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "No, this is general federal tax information based on IRS pages checked November 18, 2026, and is not tax advice. Your specific employer plan terms control what options and contribution splits are permitted. You should consult a qualified tax professional to evaluate your individual tax return and retirement situation."
                }
              }
