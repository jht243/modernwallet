          {
            "@context": "https://schema.org",
            "@type": "FAQPage",
            "mainEntity": [
              {
                "@type": "Question",
                "name": "How much will Part D cost in 2027?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "KFF projects the average stand-alone Part D premium at $51 a month in 2027, up from $34, if enrollees keep their current plans. That works out to $612 a year, or $204 more than 2026, by arithmetic. Individual premiums vary by plan, and Medicare.gov lists the maximum 2027 deductible as $700."
                }
              },
              {
                "@type": "Question",
                "name": "Is Medicare Part D going away in 2027?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "No. CMS sets a 2027 base beneficiary premium of $41.33. KFF lists eight national stand-alone plans with projected 2027 premiums, and Medicare.gov publishes 2027 deductible and out-of-pocket limits. What KFF reports is that no zero-premium stand-alone plans are available in 2027."
                }
              },
              {
                "@type": "Question",
                "name": "What do KFF and CMS say about the 2027 increase?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "KFF projects the average stand-alone premium will rise 50 percent, from $34 to $51 a month, if enrollees do not switch plans. CMS says it will end the voluntary premium stabilization demonstration for stand-alone plans at the end of 2026 and sets the 2027 base beneficiary premium at $41.33. KFF's release does not say why plans raised premiums."
                }
              },
              {
                "@type": "Question",
                "name": "When does Medicare open enrollment end?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "KFF says open enrollment runs through December 7. Plans can be compared before then in Medicare Plan Finder at medicare.gov/plan-compare."
                }
              },
              {
                "@type": "Question",
                "name": "What is the Part D deductible in 2027?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "The maximum Part D deductible in 2027 is $700, up from $615 in 2026, and some plans charge less or nothing. KFF puts the average at $643 for stand-alone plan enrollees and $489 for MA-PD enrollees. After the deductible, Medicare.gov says enrollees pay 25 percent coinsurance until out-of-pocket spending reaches $2,400."
                }
              },
              {
                "@type": "Question",
                "name": "Does Extra Help lower Part D premiums?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Medicare.gov's Extra Help page lists the 2027 plan premium and deductible as $0 for people in the program. Generic drugs cost up to $5.80 and brand-name drugs up to $14.40 at participating pharmacies, and covered drugs cost $0 once total drug costs reach $2,400. Medicare.gov says applications go through Social Security."
                }
              }
            ]
